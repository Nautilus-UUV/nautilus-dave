<?xml version="1.0"?>
<sdf version="1.7">
  <model name="neutrally_buoyant_cylinder">
    <static>false</static>
    
    <!-- HYDRODYNAMICS: Drag friction in water -->
    <plugin
      filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000</water_density>
      <xU>-50.0</xU>
      <yV>-50.0</yV>
      <zW>-50.0</zW>
      <kP>-10.0</kP>
      <mQ>-10.0</mQ>
      <nR>-10.0</nR>
    </plugin>

    <!-- BASE CYLINDER -->
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <!-- 29.0 kg base + 2.0 kg internal = 31.0 kg (under 31.41 kg displacement) -->
        <mass>29.0</mass>
        <inertia>
          <ixx>2.5248</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>2.5248</iyy>
          <iyz>0.0</iyz>
          <izz>0.1471</izz>
        </inertia>
      </inertial>

      <!-- COLLISION: Box shape with identical volume so graded_buoyancy calculates displacement -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.17725 0.17725 1.0</size>
          </box>
        </geometry>
      </collision>

      <!-- VISUAL: Remains a clean cylinder in the GUI -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>1.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.6 1.0 0.4</ambient>
          <diffuse>0.2 0.6 1.0 0.4</diffuse>
        </material>
      </visual>
    </link>

    <!-- INTERNAL MOVING MASS -->
    <link name="internal_mass_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002</iyy>
          <iyz>0</iyz>
          <izz>0.002</izz>
        </inertia>
      </inertial>
      
      <visual name="mass_visual">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
        </material>
      </visual>
    </link>

    <joint name="mass_slider_joint" type="prismatic">
      <parent>base_link</parent>
      <child>internal_mass_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.40</lower>  <!-- z = -0.40 (bottom) -->
          <upper>0.40</upper>   <!-- z = -0.10 (top) -->
          <effort>500</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>mass_slider_joint</joint_name>
      <p_gain>200.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>40.0</d_gain>
      <i_max>10</i_max>
      <i_min>-10</i_min>
      <cmd_max>500</cmd_max>
      <cmd_min>-500</cmd_min>
    </plugin>
  </model>
</sdf>